<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<form action="edit" method="POST">
{{#if post}}
<div class="form-group">
    <label for="exampleFormControlInput1">Nomi</label>
    <input type="text" class="form-control" value="{{post.title}}" name="title" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1"> Narx</label>
    <input type="number" class="form-control" value="{{post.sum}}" name="sum" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1"> address</label>
    <input type="text" class="form-control" value="{{post.region}}" name="region" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1">Img</label>
    <input type="text" class="form-control" value="{{post.img}}" name="img" required>
  </div>
  <div class="form-group">
    <label for="desc">Description</label>
    <textarea type="text" class="form-control" name="desc" id="desc" value="{{post.desc}}" required></textarea>
    <script>
        CKEDITOR.replace('desc');
    </script>
  </div>


  <button type="submit" class="btn btn-danger">Edit</button>
{{/if}}
</form>