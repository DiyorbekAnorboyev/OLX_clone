<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<form action="/posts/add" method="POST">
  <div class="form-group">
    <label for="exampleFormControlInput1">Nomi</label>
    <input type="text" class="form-control" name="title" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1"> Narx</label>
    <input type="number" class="form-control" name="sum" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1"> address</label>
    <input type="text" class="form-control" name="region" required>
  </div>
  <div class="form-group">
    <label for="exampleFormControlInput1">Img</label>
    <input type="text" class="form-control" name="img" required>
  </div>
  <div class="form-group">
    <label for="desc">Description</label>
    <textarea type="text" class="form-control" name="desc" id="desc" required></textarea>
    <script>
        CKEDITOR.replace('desc');
    </script>
  </div>

  <button type="submit" class="btn btn-danger">Add</button>
</form>